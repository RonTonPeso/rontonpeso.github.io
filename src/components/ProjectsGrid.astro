---
import { projects as defaultProjects, type Project } from "../data/projects";
import { basePath } from "../lib/paths";

interface Props {
	projects?: Project[];
	heading?: string;
	/** On /projects this grid is the whole page, so its heading is the h1. */
	level?: "h1" | "h2";
}

const { projects = defaultProjects, heading = "Projects", level = "h2" } = Astro.props as Props;
const Heading = level;
// Row titles sit one level below the grid heading, whatever that is.
const RowHeading = level === "h1" ? "h2" : "h3";
---

<section id="projects" class="page-section" aria-labelledby="projects-heading">
	<Heading id="projects-heading" class="section-heading">{heading}</Heading>
	<div class="project-rows">
		{
			projects.map((project, index) => (
				<article class="project-row">
					<span class="row-index" aria-hidden="true">
						{String(index + 1).padStart(2, "0")}
					</span>
					{project.logo && (
						<img
							class="row-logo"
							src={`${basePath}${project.logo}`}
							alt=""
							width="40"
							height="46"
							loading="lazy"
						/>
					)}
					<div class="row-body">
						{project.kind && <span class="row-kind">{project.kind}</span>}
						<RowHeading class="row-title">
							<a class="row-link" href={`${basePath}projects/${project.slug}`}>
								{project.title}
								<span class="row-arrow" aria-hidden="true">&#8594;</span>
							</a>
						</RowHeading>
						<p class="row-desc">{project.description}</p>
						<ul class="project-tags" aria-label={`${project.title} technologies`}>
							{project.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
					</div>
				</article>
			))
		}
	</div>
</section>
