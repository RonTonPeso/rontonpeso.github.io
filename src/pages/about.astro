---
import BaseLayout from "../layouts/BaseLayout.astro";
import { basePath } from "../lib/paths";

const aboutPhoto = `${basePath}ronnie-portrait.jpg`;
---

<BaseLayout
	title="About Ronnie Wang"
	description="Ronnie Wang studies computer science at Penn and does bioinformatics research in the Cheng Lab. Short page, longer project write-ups."
>
	<section class="page-section text-page">
		<h1 class="page-title">About</h1>
		<div class="about-layout">
			<div class="about-side">
				<div class="about-photo">
					<img
						src={aboutPhoto}
						alt="Ronnie Wang at a table by a window, a large plant behind him"
						width="900"
						height="1142"
					/>
				</div>
				<dl class="about-facts">
					<div>
						<dt>Studying</dt>
						<dd>Computer science, BSE and Masters, Penn Engineering</dd>
					</div>
					<div>
						<dt>Research</dt>
						<dd>Cheng Lab, bioinformatics</dd>
					</div>
					<div>
						<dt>Building</dt>
						<dd>Dynamic interfaces</dd>
					</div>
				</dl>
			</div>
			<div class="about-body">
				<div class="prose">
					<p>
						I study computer science at Penn, BSE and Masters, and my research is on
						the bioinformatics side of the Cheng Lab. Most of what is on this site
						started as a question I could not answer by reading about it: how a
						scheduler decides who runs next, what a feature flag service has to
						guarantee, whether a hardness model can tell you when to stop trusting
						it. The write-ups are longer than this page on purpose.
					</p>
				</div>
				<div class="link-row" aria-label="Contact links">
					<a class="text-link" href="mailto:wronnie@seas.upenn.edu">Email me</a>
					<a class="text-link" href="https://github.com/RonTonPeso">GitHub</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
