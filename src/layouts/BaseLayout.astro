---
import { basePath, withBase } from "../lib/paths";
import "../styles/tokens.css";
import "../styles/fonts.css";
const {
	title = "Ronnie Wang",
	description = "Ronnie Wang, software engineer. Computer science at Penn, bioinformatics research in the Cheng Lab."
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === basePath || pathname === basePath.slice(0, -1);
const currentPath = pathname.startsWith(basePath)
	? `/${pathname.slice(basePath.length)}`
	: pathname;
const penguinImage = withBase("penguin_profile.png");
const socialImage = new URL(penguinImage, Astro.site ?? Astro.url).toString();

const canonicalURL = new URL(pathname, Astro.site ?? Astro.url).toString();
const homeURL = new URL(withBase("/"), Astro.site ?? Astro.url).toString();

// Person structured data so search engines understand the site is about Ronnie Wang
const personLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Ronnie Wang",
	alternateName: "Ronald Wang",
	url: homeURL,
	image: socialImage,
	jobTitle: "Software Engineer",
	alumniOf: {
		"@type": "CollegeOrUniversity",
		name: "University of Pennsylvania"
	},
	knowsAbout: ["Artificial Intelligence", "Software Engineering", "Systems", "Infrastructure"],
	sameAs: ["https://github.com/RonTonPeso"]
};
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google tag (gtag.js) -->
		<script
			is:inline
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-K5YLQH3ZZ7"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());

			gtag("config", "G-K5YLQH3ZZ7");
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-site-verification" content="x6D758Wn4RdeYgDi1gseTcoBeaapzKzCB0OKzah46lQ" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
		<link rel="icon" type="image/png" href={penguinImage} />
		<link
			rel="preload"
			href={withBase("fonts/fraunces-display.woff2")}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<title>{title}</title>
		<style is:global>
			:root {
				color: var(--ink);
				background: var(--ground);
				font-family: var(--font-body);
			}

			* {
				box-sizing: border-box;
			}

			html {
				background: var(--ground);
			}

			body {
				position: relative;
				margin: 0;
				min-height: 100vh;
				overflow-x: hidden;
				background: var(--ground);
				color: var(--ink);
			}

			/* The aurora. One event, at the top of the home page, in the accent
			   hue only. Everywhere else the ground is just the ground. */
			body[data-route="home"]::before {
				position: absolute;
				inset: 0 0 auto;
				z-index: 0;
				height: 70vh;
				background: repeating-linear-gradient(
					93deg,
					transparent 0 3rem,
					var(--aurora) 4.5rem,
					transparent 7rem 13rem
				);
				content: "";
				filter: blur(40px);
				mask-image: linear-gradient(to bottom, #000 0%, transparent 78%);
				-webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 78%);
				pointer-events: none;
				transform: skewX(-7deg);
			}


			a {
				color: inherit;
				text-decoration: none;
			}

			:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 3px;
				border-radius: var(--radius-edge);
			}

			::selection {
				background: var(--accent);
				color: var(--ground);
			}

			:root {
				caret-color: var(--accent);
			}

			/* no bar: nav floats on the sky. Children stay clickable, the strip itself doesn't block the hero. */
			.site-nav {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				z-index: 10;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: var(--s4);
				padding: var(--s5) var(--gutter) var(--s4);
				pointer-events: none;
			}

			.site-nav a,
			.site-nav nav {
				pointer-events: auto;
			}

			.site-name {
				display: inline-flex;
				align-items: center;
				gap: var(--s3);
				color: var(--ink);
				font-family: var(--font-display);
				font-size: var(--t-base);
				font-weight: 800;
				letter-spacing: -0.01em;
			}

			.site-mark {
				width: 2.1rem;
				height: 2.1rem;
				border: 1px solid var(--line-strong);
				border-radius: 50%;
				background: var(--ground-lift);
				object-fit: cover;
			}

			.nav-links {
				display: flex;
				gap: var(--s5);
				color: var(--ink-muted);
				font-size: var(--t-sm);
				letter-spacing: var(--track-label);
				text-transform: uppercase;
			}

			.nav-links a {
				position: relative;
				transition: color var(--dur-state) var(--ease-out);
			}

			.nav-links a[aria-current="page"] {
				color: var(--ink);
			}

			.nav-links a[aria-current="page"]::after {
				position: absolute;
				right: 0;
				bottom: -0.5rem;
				left: 0;
				height: 2px;
				border-radius: var(--radius-edge);
				background: var(--accent);
				content: "";
			}

			.nav-links a:hover {
				color: var(--ink);
			}

			main {
				position: relative;
				z-index: 1;
				width: 100%;
				margin: 0 auto;
			}

			.page-section {
				position: relative;
				isolation: isolate;
				width: min(var(--page), calc(100% - var(--gutter) * 2));
				margin: 0 auto;
				padding: var(--rhythm-section) 0;
			}

			/* A chapter break: the gap between the hero and the work below it is
			   larger than the gap between anything inside a section. */
			.hero + .page-section {
				padding-top: var(--rhythm-chapter);
			}


			.hero {
				position: relative;
				isolation: isolate;
				display: grid;
				align-content: center;
				width: min(var(--page), calc(100% - var(--gutter) * 2));
				/* svh, not vh: mobile browser chrome should not push the scroll
				   cue off screen. The old calc(100vh - 68px) subtracted the height
				   of a nav that is position:absolute and out of flow. */
				min-height: 100svh;
				margin: 0 auto;
				padding: var(--rhythm-chapter) 0 var(--rhythm-section);
			}


			.hero-content {
				position: relative;
				z-index: 1;
				max-width: 880px;
			}






			.hero h1.hero-name {
				font-size: clamp(var(--t-4xl), 13vw, 9.313rem);
				line-height: 0.92;
				letter-spacing: -0.045em;
			}

			.hero-line {
				display: block;
			}

			.hero-line:nth-child(2) {
				margin-left: 0.06em;
			}

			/* Karrik ships one weight, so emphasis is italic rather than bold.
			   Green is not available here: it has four jobs and this is not one. */
			.hero-blurb .hl-ai {
				font-style: italic;
			}

			/* DIRECTION.md section 4: the one deliberate break. Everything on this
			   site hangs off the same left edge except the least serious word on it. */
			.hero-blurb .hl-peng {
				display: block;
				margin-left: -0.68em;
				font-style: italic;
			}

			.hero-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: var(--s4);
				margin-top: var(--s6);
				color: var(--ink-soft);
				font-size: var(--t-sm);
				letter-spacing: var(--track-label);
				text-transform: uppercase;
			}

			.meta-sep {
				width: 4px;
				height: 4px;
				border-radius: 50%;
				background: var(--ink-soft);
				opacity: 0.5;
			}

			.meta-status {
				display: inline-flex;
				align-items: center;
				color: var(--ink-muted);
			}

			.status-dot {
				width: 7px;
				height: 7px;
				margin-right: var(--s2);
				border-radius: 50%;
				background: var(--accent);
			}

			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: var(--s4);
				margin-top: var(--s6);
			}

			.btn-primary,
			.btn-ghost {
				display: inline-flex;
				align-items: center;
				gap: var(--s2);
				border-radius: 999px;
				padding: var(--s3) var(--s5);
				font-size: var(--t-sm);
				font-weight: 600;
				letter-spacing: 0.02em;
				text-transform: uppercase;
				transition:
					transform var(--dur-state) var(--ease-out),
					border-color var(--dur-state) var(--ease-out),
					color var(--dur-state) var(--ease-out);
			}

			.btn-primary {
				color: var(--ground);
				background: var(--accent);
			}

			.btn-primary:hover,
			.btn-primary:focus-visible {
			}

			.btn-ghost {
				color: var(--ink);
				border: 1px solid var(--line-strong);
				background: transparent;
			}

			.btn-ghost:hover,
			.btn-ghost:focus-visible {
				border-color: var(--accent);
				color: var(--accent);
			}

			.btn-icon {
				width: 1.05rem;
				height: 1.05rem;
				flex: none;
			}

			/* animated scroll cue pinned to the bottom of the hero */
			.hero-scroll {
				position: absolute;
				bottom: 2.2rem;
				left: 0;
				z-index: 1;
				display: inline-flex;
				align-items: center;
				gap: var(--s3);
				color: var(--ink-soft);
				font-size: var(--t-sm);
				letter-spacing: 0.14em;
				text-transform: uppercase;
				transition: color var(--dur-state) var(--ease-out);
			}

			.hero-scroll:hover,
			.hero-scroll:focus-visible {
				color: var(--accent);
			}

			.scroll-line {
				position: relative;
				width: 58px;
				height: 1px;
				background: var(--accent);
			}

			.text-link {
				color: var(--ink);
				text-decoration: underline;
				text-decoration-color: var(--accent);
				text-decoration-thickness: 1px;
				text-underline-offset: 0.3em;
				transition: color var(--dur-state) var(--ease-out);
			}

			.text-link:hover,
			.text-link:focus-visible {
				color: var(--accent);
			}

			.kicker {
				margin: 0 0 var(--s4);
				color: var(--ink-soft);
				font-size: var(--t-sm);
				font-weight: 600;
				letter-spacing: var(--track-label);
				text-transform: uppercase;
			}

			.hero h1,
			.page-title {
				margin: 0;
				color: var(--ink);
				font-family: var(--font-display);
				font-size: var(--t-5xl);
				font-weight: 900;
				letter-spacing: var(--track-display);
				line-height: var(--lh-display);
				text-wrap: balance;
			}

			.blurb {
				text-wrap: pretty;
				max-width: var(--measure);
				margin: var(--s5) 0 0;
				color: var(--ink-muted);
				font-size: var(--t-md);
				line-height: var(--lh-body);
			}

			.section-heading {
				text-wrap: balance;
				margin: 0 0 var(--s5);
				color: var(--ink);
				font-family: var(--font-display);
				font-size: var(--t-4xl);
				font-weight: 900;
				letter-spacing: var(--track-display);
				line-height: var(--lh-display);
			}

			/* projects as editorial index rows, not a grid */
			.project-rows {
				display: flex;
				flex-direction: column;
			}

			.project-row {
				position: relative;
				display: grid;
				grid-template-columns: 2.5rem 2.5rem minmax(0, 1fr);
				gap: var(--s5);
				align-items: start;
				padding: var(--s5) 0;
				border-top: 1px solid var(--line);
				isolation: isolate;
			}

			.project-row:last-child {
				border-bottom: 1px solid var(--line);
			}

			/* aurora glow sweeps in from the left on hover */
			.project-row::before {
				position: absolute;
				inset: 0;
				z-index: -1;
				background: linear-gradient(90deg, var(--aurora), transparent 62%);
				content: "";
				opacity: 0;
				transition: opacity var(--dur-state) var(--ease-out);
			}

			.project-row:hover::before,
			.project-row:focus-within::before {
				opacity: 1;
			}



			.row-logo {
				width: 2.5rem;
				height: 2.5rem;
				border-radius: var(--radius-edge);
				object-fit: contain;
			}

			/* The index hangs into the margin: the only column that is not content. */
			.row-index {
				color: var(--ink-soft);
				font-size: var(--t-sm);
				font-variant-numeric: tabular-nums;
				letter-spacing: var(--track-label);
				line-height: 1.9;
			}

			.row-kind {
				display: inline-block;
				margin: 0 0 var(--s2);
				color: var(--ink-soft);
				font-size: var(--t-sm);
				font-weight: 500;
				letter-spacing: var(--track-label);
				text-transform: uppercase;
			}

			.row-title {
				text-wrap: balance;
				margin: 0;
				font-family: var(--font-display);
				font-size: var(--t-2xl);
				font-weight: 800;
				letter-spacing: var(--track-display);
				line-height: var(--lh-display);
			}

			.row-link {
				color: var(--ink);
				transition: color var(--dur-state) var(--ease-out);
			}

			.project-row:hover .row-link,
			.row-link:focus-visible {
				color: var(--accent);
			}

			.row-arrow {
				display: inline-block;
				margin-left: var(--s2);
				/* Fraunces draws no U+2192; Karrik does. Keep the arrow in the body face. */
				font-family: var(--font-body);
				color: currentColor;
				font-size: 0.6em;
				opacity: 0;
				transform: translate(-5px, 5px);
				transition:
					opacity var(--dur-state) var(--ease-out),
					transform var(--dur-state) var(--ease-out);
			}

			.project-row:hover .row-arrow,
			.row-link:focus-visible .row-arrow {
				opacity: 1;
				transform: translate(0, 0);
			}

			.row-desc {
				text-wrap: pretty;
				max-width: var(--measure);
				margin: var(--s4) 0 0;
				color: var(--ink-muted);
				font-size: var(--t-base);
				line-height: var(--lh-body);
			}

			.back-link:hover,
			.back-link:focus-visible {
				text-decoration: underline;
				text-underline-offset: 0.3em;
			}

			.project-tags {
				display: flex;
				flex-wrap: wrap;
				gap: var(--s2);
				list-style: none;
				margin: var(--s5) 0 0;
				padding: 0;
			}

			.project-tags li {
				color: var(--ink-soft);
				font-size: var(--t-sm);
				letter-spacing: var(--track-label);
				line-height: 1;
				text-transform: uppercase;
			}

			/* A middot between tags reads as a list without drawing six boxes. */
			.project-tags li + li::before {
				margin-right: var(--s2);
				color: var(--line-strong);
				content: "·";
			}

			.detail-tags {
				margin-top: var(--s6);
			}

			.link-row {
				display: flex;
				flex-wrap: wrap;
				gap: var(--s3);
				margin-top: var(--s5);
			}

			/* compact variant of the hero pills, sized for the detail aside */
			.link-btn {
				padding: var(--s3) var(--s4);
				font-size: var(--t-sm);
			}

			.back-link {
				display: inline-block;
				margin-bottom: var(--s6);
				color: var(--ink-muted);
				font-size: var(--t-sm);
				font-weight: 700;
			}

			.prose {
				max-width: var(--measure);
				margin-top: var(--s6);
			}

			.prose p {
				text-wrap: pretty;
				margin: 0 0 var(--s4);
				color: var(--ink-muted);
				font-size: var(--t-base);
				line-height: var(--lh-body);
			}

			.project-detail {
				min-height: auto;
			}

			.detail-header {
				max-width: 860px;
			}

			.detail-body {
				display: grid;
				grid-template-columns: minmax(0, 760px) minmax(12rem, 1fr);
				gap: var(--s7);
				align-items: start;
				margin-top: var(--s7);
			}

			.detail-aside {
				position: sticky;
				top: 7rem;
				border-left: 1px solid var(--line);
				padding-left: var(--s4);
			}

			.aside-title {
				letter-spacing: var(--track-label);
				margin: 0 0 var(--s3);
				color: var(--ink-soft);
				font-size: var(--t-sm);
				line-height: 1.5;
				text-transform: uppercase;
			}

			.project-embed {
				width: 100%;
				min-height: 420px;
				margin-top: var(--s6);
				border: 1px solid var(--line);
				border-radius: var(--radius-edge);
				background: var(--ground-lift);
			}

			.text-page {
				min-height: auto;
			}

			.about-layout {
				display: grid;
				grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr);
				gap: var(--s7);
				align-items: start;
				margin-top: var(--s7);
			}

			.about-photo {
				position: relative;
				margin: 0;
			}


			.about-photo img {
				display: block;
				width: 100%;
				aspect-ratio: 4 / 5;
				border: 1px solid var(--line-strong);
				border-radius: var(--radius-edge);
				object-fit: cover;
				object-position: 50% 38%;
			}

			.about-photo figcaption {
				margin-top: var(--s3);
				color: var(--ink-soft);
				font-size: var(--t-sm);
			}

			.about-side {
				display: grid;
				gap: var(--s5);
			}

			/* field-notes style fact list */
			.about-facts {
				display: grid;
				gap: var(--s4);
				margin: 0;
			}

			.about-facts > div {
				display: grid;
				gap: var(--s1);
				border-left: 1px solid var(--line);
				padding-left: var(--s4);
			}

			.about-facts dt {
				color: var(--ink-soft);
				font-size: var(--t-xs);
				letter-spacing: var(--track-label);
				text-transform: uppercase;
			}

			.about-facts dd {
				margin: 0;
				color: var(--ink-muted);
				font-size: var(--t-base);
				line-height: 1.45;
			}

			.site-footer {
				position: relative;
				z-index: 1;
				margin-top: var(--s9);
				padding: var(--s6) var(--s4) var(--s7);
				text-align: center;
			}

			.footer-line {
				margin: 0;
				color: var(--ink-soft);
				font-size: var(--t-sm);
				letter-spacing: 0.02em;
			}

			.footer-line a {
				color: var(--ink-muted);
				transition: color var(--dur-state) var(--ease-out);
			}

			.footer-line a {
				text-decoration: underline;
				text-decoration-color: var(--accent);
				text-underline-offset: 0.3em;
			}

			.footer-line a:hover,
			.footer-line a:focus-visible {
				color: var(--ink);
			}



				to {
					background-position: 32% 0%, 68% 0%;
					transform: skewX(-4deg) translate3d(3vw, 1.5vh, 0);
				}
			}

				to {
					opacity: 0.95;
				}
			}

				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

				to {
					background-position: 100% 50%;
				}
			}

				50% {
					opacity: 0.45;
					transform: scale(0.78);
				}
			}

				100% {
					transform: translateX(240%);
				}
			}

			@media (max-width: 920px) {
				.hero h1,
				.page-title {
					font-size: var(--t-4xl);
				}

				.section-heading {
					font-size: var(--t-3xl);
				}

				.about-layout,
				.detail-body {
					grid-template-columns: 1fr;
				}

				.detail-aside {
					position: static;
					border-left: 0;
					border-top: 1px solid var(--line);
					padding: var(--s4) 0 0;
				}
			}

			@media (max-width: 700px) {
				.site-nav {
					align-items: center;
					padding: var(--s3) var(--s4);
				}

				.site-name span {
					display: none;
				}

				.nav-links {
					gap: var(--s3);
					font-size: var(--t-sm);
				}

				.hero {
					padding: var(--rhythm-section) 0;
				}

				.hero-scroll {
					bottom: 1.4rem;
				}

				.hero-meta {
					font-size: var(--t-xs);
					gap: var(--s3);
				}

				.hero h1,
				.page-title {
					font-size: var(--t-3xl);
					line-height: 1;
				}

				.blurb {
					font-size: var(--t-base);
				}

				.section-heading {
					font-size: var(--t-2xl);
				}

				.page-section {
					padding: var(--s8) 0;
				}

				.project-row {
					grid-template-columns: 2.6rem minmax(0, 1fr);
					gap: var(--s4);
					padding: var(--s6) var(--s2);
				}

				.project-row:hover,
				.project-row:focus-within {
					padding-left: var(--s4);
				}

				.row-title {
					font-size: var(--t-xl);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				/* A genuine no-motion path, not a 1ms duration. Nothing moves;
				   hover and focus still change colour, so states stay legible. */
				*,
				*::before,
				*::after {
					animation: none !important;
					transition: none !important;
				}

				html {
					scroll-behavior: auto;
				}
			}
		</style>
	</head>
	<body data-route={isHome ? "home" : undefined}>
		<header class="site-nav">
			<a class="site-name" href={withBase("/")}>
				<img class="site-mark" src={penguinImage} alt="" />
				<span>Ronnie Wang</span>
			</a>
			<nav class="nav-links" aria-label="Main navigation">
				<a
					href={withBase("/projects")}
					aria-current={currentPath.startsWith("/projects") ? "page" : undefined}
					>Projects</a
				>
				<a
					href={withBase("/about")}
					aria-current={currentPath.startsWith("/about") ? "page" : undefined}
					>About</a
				>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p class="footer-line">
				© {new Date().getFullYear()} Ronnie Wang · <a href="mailto:wronnie@seas.upenn.edu">wronnie@seas.upenn.edu</a>
			</p>
		</footer>
	</body>
</html>
