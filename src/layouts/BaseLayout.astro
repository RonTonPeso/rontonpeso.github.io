---
import { basePath, withBase } from "../lib/paths";
import "../styles/tokens.css";
import "../styles/fonts.css";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/components.css";
import "../styles/responsive.css";
const {
	title = "Ronnie Wang",
	description = "Ronnie Wang, software engineer. Computer science at Penn, bioinformatics research in the Cheng Lab."
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === basePath || pathname === basePath.slice(0, -1);
const currentPath = pathname.startsWith(basePath)
	? `/${pathname.slice(basePath.length)}`
	: pathname;
const penguinImage = withBase("penguin_profile.png");
const socialImage = new URL(withBase("og.png"), Astro.site ?? Astro.url).toString();

const canonicalURL = new URL(pathname, Astro.site ?? Astro.url).toString();
const homeURL = new URL(withBase("/"), Astro.site ?? Astro.url).toString();

// Person structured data so search engines understand the site is about Ronnie Wang
const personLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Ronnie Wang",
	alternateName: "Ronald Wang",
	url: homeURL,
	image: new URL(penguinImage, Astro.site ?? Astro.url).toString(),
	jobTitle: "Software Engineer",
	alumniOf: {
		"@type": "CollegeOrUniversity",
		name: "University of Pennsylvania"
	},
	knowsAbout: ["Artificial Intelligence", "Software Engineering", "Systems", "Infrastructure"],
	sameAs: ["https://github.com/RonTonPeso"]
};
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google tag (gtag.js) -->
		<script
			is:inline
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-K5YLQH3ZZ7"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());

			gtag("config", "G-K5YLQH3ZZ7");
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-site-verification" content="x6D758Wn4RdeYgDi1gseTcoBeaapzKzCB0OKzah46lQ" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ronnie Wang, set in Fraunces on a dark ground, under a green aurora." />
		<meta property="og:site_name" content="Ronnie Wang" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
		<link rel="icon" type="image/png" sizes="32x32" href={withBase("favicon-32.png")} />
		<link rel="apple-touch-icon" sizes="180x180" href={withBase("apple-touch-icon.png")} />
		<link rel="manifest" href={withBase("site.webmanifest")} />
		<meta name="theme-color" content="#040d10" />
		<link
			rel="preload"
			href={withBase("fonts/fraunces-display.woff2")}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href={withBase("fonts/karrik-regular.woff2")}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<title>{title}</title>
	</head>
	<body data-route={isHome ? "home" : undefined}>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-nav">
			<a class="site-name" href={withBase("/")}>
				<img class="site-mark" src={penguinImage} alt="" width="34" height="34" />
				<span>Ronnie Wang</span>
			</a>
			<nav class="nav-links" aria-label="Main navigation">
				<a
					href={withBase("/projects")}
					aria-current={currentPath.startsWith("/projects") ? "page" : undefined}
					>Projects</a
				>
				<a
					href={withBase("/about")}
					aria-current={currentPath.startsWith("/about") ? "page" : undefined}
					>About</a
				>
			</nav>
		</header>
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<footer class="site-footer">
			<p class="footer-line">
				© {new Date().getFullYear()} Ronnie Wang · <a href="mailto:wronnie@seas.upenn.edu">wronnie@seas.upenn.edu</a>
			</p>
		</footer>
	</body>
</html>
