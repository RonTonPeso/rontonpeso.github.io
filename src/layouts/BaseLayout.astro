---
import { basePath, withBase } from "../lib/paths";
import "../styles/tokens.css";
import "../styles/fonts.css";
const {
	title = "Ronnie Wang",
	description = "Ronnie Wang is a software engineer and University of Pennsylvania computer science student, passionate about AI."
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === basePath || pathname === basePath.slice(0, -1);
const currentPath = pathname.startsWith(basePath)
	? `/${pathname.slice(basePath.length)}`
	: pathname;
const penguinImage = withBase("penguin_profile.png");
const socialImage = new URL(penguinImage, Astro.site ?? Astro.url).toString();

const canonicalURL = new URL(pathname, Astro.site ?? Astro.url).toString();
const homeURL = new URL(withBase("/"), Astro.site ?? Astro.url).toString();

// Person structured data so search engines understand the site is about Ronnie Wang
const personLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Ronnie Wang",
	alternateName: "Ronald Wang",
	url: homeURL,
	image: socialImage,
	jobTitle: "Software Engineer",
	alumniOf: {
		"@type": "CollegeOrUniversity",
		name: "University of Pennsylvania"
	},
	knowsAbout: ["Artificial Intelligence", "Software Engineering", "Systems", "Infrastructure"],
	sameAs: ["https://github.com/RonTonPeso"]
};
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google tag (gtag.js) -->
		<script
			is:inline
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-K5YLQH3ZZ7"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());

			gtag("config", "G-K5YLQH3ZZ7");
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-site-verification" content="x6D758Wn4RdeYgDi1gseTcoBeaapzKzCB0OKzah46lQ" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
		<link rel="icon" type="image/png" href={penguinImage} />
		<link
			rel="preload"
			href={withBase("fonts/fraunces-display.woff2")}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<title>{title}</title>
		<style is:global>
			:root {
				color: var(--ink);
				background: var(--ground);
				font-family: var(--font-body);
			}

			* {
				box-sizing: border-box;
			}

			html {
				background: var(--ground);
			}

			body {
				position: relative;
				margin: 0;
				min-height: 100vh;
				overflow-x: hidden;
				background: var(--ground);
				color: var(--ink);
			}

			/* The aurora. One event, at the top of the home page, in the accent
			   hue only. Everywhere else the ground is just the ground. */
			body[data-route="home"]::before {
				position: absolute;
				inset: 0 0 auto;
				z-index: 0;
				height: 70vh;
				background: repeating-linear-gradient(
					93deg,
					transparent 0 3rem,
					var(--aurora) 4.5rem,
					transparent 7rem 13rem
				);
				content: "";
				filter: blur(40px);
				mask-image: linear-gradient(to bottom, #000 0%, transparent 78%);
				-webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 78%);
				pointer-events: none;
				transform: skewX(-7deg);
			}


			a {
				color: inherit;
				text-decoration: none;
			}

			:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 3px;
				border-radius: 1px;
			}

			::selection {
				background: var(--accent);
				color: var(--ground);
			}

			:root {
				caret-color: var(--accent);
			}

			/* no bar: nav floats on the sky. Children stay clickable, the strip itself doesn't block the hero. */
			.site-nav {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				z-index: 10;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 1.7rem clamp(1.5rem, 4vw, 3.5rem) 1rem;
				pointer-events: none;
			}

			.site-nav a,
			.site-nav nav {
				pointer-events: auto;
			}

			.site-name {
				display: inline-flex;
				align-items: center;
				gap: 0.7rem;
				color: var(--ink);
				font-family: var(--font-display);
				font-size: 1.05rem;
				font-weight: 800;
				letter-spacing: -0.01em;
			}

			.site-mark {
				width: 2.1rem;
				height: 2.1rem;
				border: 1px solid var(--line-strong);
				border-radius: 50%;
				background: var(--ground-lift);
				object-fit: cover;
			}

			.nav-links {
				display: flex;
				gap: 1.5rem;
				color: var(--ink-muted);
				font-size: 0.84rem;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}

			.nav-links a {
				position: relative;
				transition: color var(--dur-state) var(--ease-out);
			}

			.nav-links a[aria-current="page"] {
				color: var(--accent);
			}

			.nav-links a[aria-current="page"]::after {
				position: absolute;
				right: 0;
				bottom: -0.5rem;
				left: 0;
				height: 2px;
				border-radius: 2px;
				background: var(--accent);
				content: "";
			}

			.nav-links a:hover,
			.nav-links a:focus-visible {
				color: var(--accent);
			}

			main {
				position: relative;
				z-index: 1;
				width: 100%;
				margin: 0 auto;
			}

			.page-section {
				position: relative;
				isolation: isolate;
				width: min(var(--page), calc(100% - 2rem));
				margin: 0 auto;
				padding: 7rem 0;
			}


			.hero {
				position: relative;
				isolation: isolate;
				display: grid;
				align-content: center;
				width: min(var(--page), calc(100% - 2rem));
				min-height: calc(100vh - 68px);
				margin: 0 auto;
				padding: 7rem 0 9rem;
			}


			.hero-content {
				position: relative;
				z-index: 1;
				max-width: 880px;
			}






			.hero h1.hero-name {
				font-size: clamp(3.4rem, 13vw, 9.5rem);
				line-height: 0.92;
				letter-spacing: -0.045em;
			}

			.hero-line {
				display: block;
			}

			.hero-line:nth-child(2) {
				margin-left: 0.06em;
			}

			.hero-blurb .hl-ai {
				color: var(--accent);
			}

			.hero-blurb .hl-peng {
				color: var(--accent);
			}

			.hero-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.9rem;
				margin-top: 1.9rem;
				color: var(--ink-soft);
				font-size: 0.78rem;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}

			.meta-sep {
				width: 4px;
				height: 4px;
				border-radius: 50%;
				background: var(--ink-soft);
				opacity: 0.5;
			}

			.meta-status {
				display: inline-flex;
				align-items: center;
				color: var(--ink-muted);
			}

			.status-dot {
				width: 7px;
				height: 7px;
				margin-right: 0.5rem;
				border-radius: 50%;
				background: var(--accent);
			}

			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.9rem;
				margin-top: 2.1rem;
			}

			.btn-primary,
			.btn-ghost {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				border-radius: 999px;
				padding: 0.82rem 1.45rem;
				font-size: 0.82rem;
				font-weight: 600;
				letter-spacing: 0.02em;
				text-transform: uppercase;
				transition:
					transform var(--dur-state) var(--ease-out),
					border-color var(--dur-state) var(--ease-out),
					color var(--dur-state) var(--ease-out);
			}

			.btn-primary {
				color: var(--ground);
				background: var(--accent);
			}

			.btn-primary:hover,
			.btn-primary:focus-visible {
			}

			.btn-ghost {
				color: var(--ink);
				border: 1px solid var(--line-strong);
				background: transparent;
			}

			.btn-ghost:hover,
			.btn-ghost:focus-visible {
				border-color: var(--accent);
				color: var(--accent);
			}

			.btn-icon {
				width: 1.05rem;
				height: 1.05rem;
				flex: none;
			}

			/* animated scroll cue pinned to the bottom of the hero */
			.hero-scroll {
				position: absolute;
				bottom: 2.2rem;
				left: 0;
				z-index: 1;
				display: inline-flex;
				align-items: center;
				gap: 0.85rem;
				color: var(--ink-soft);
				font-size: 0.74rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				transition: color var(--dur-state) var(--ease-out);
			}

			.hero-scroll:hover,
			.hero-scroll:focus-visible {
				color: var(--accent);
			}

			.scroll-line {
				position: relative;
				width: 58px;
				height: 1px;
				background: var(--line-strong);
				overflow: hidden;
			}

			.scroll-line::after {
				position: absolute;
				inset: 0;
				width: 42%;
				background: var(--accent);
				content: "";
			}

			.kicker {
				margin: 0 0 1rem;
				color: var(--accent);
				font-size: 0.8rem;
				font-weight: 600;
				letter-spacing: 0;
				text-transform: uppercase;
			}

			.hero h1,
			.page-title {
				margin: 0;
				color: var(--ink);
				font-family: var(--font-display);
				font-size: 6rem;
				font-weight: 900;
				letter-spacing: -0.025em;
				line-height: 0.92;
				text-wrap: balance;
			}

			.blurb {
				max-width: 620px;
				margin: 1.5rem 0 0;
				color: var(--ink-muted);
				font-size: 1.35rem;
				line-height: 1.55;
			}

			.section-heading {
				margin: 0 0 1.5rem;
				color: var(--ink);
				font-family: var(--font-display);
				font-size: 3.8rem;
				font-weight: 900;
				letter-spacing: -0.02em;
				line-height: 1;
			}

			/* projects as editorial index rows, not a grid */
			.project-rows {
				display: flex;
				flex-direction: column;
			}

			.project-row {
				position: relative;
				display: grid;
				grid-template-columns: 3.4rem minmax(0, 1fr);
				gap: 1.5rem;
				align-items: start;
				padding: 2.4rem 1.25rem 2.4rem 0.75rem;
				border-top: 1px solid var(--line);
				isolation: isolate;
				transition: padding-left var(--dur-layout) var(--ease-out);
			}

			.project-row:last-child {
				border-bottom: 1px solid var(--line);
			}

			/* aurora glow sweeps in from the left on hover */
			.project-row::before {
				position: absolute;
				inset: 0;
				z-index: -1;
				background: linear-gradient(90deg, var(--aurora), transparent 62%);
				content: "";
				opacity: 0;
				transition: opacity var(--dur-state) var(--ease-out);
			}

			.project-row:hover::before,
			.project-row:focus-within::before {
				opacity: 1;
			}

			.project-row:hover,
			.project-row:focus-within {
				padding-left: 1.6rem;
			}

			/* project logo (filler shows the initial when no image is set) */
			.row-logo {
				display: grid;
				place-items: center;
				width: 3.4rem;
				height: 3.4rem;
				border: 1px solid var(--line-strong);
				border-radius: 12px;
				background: var(--ground-lift);
				color: var(--accent);
				font-family: var(--font-display);
				font-size: 1.5rem;
				font-weight: 800;
				line-height: 1;
				overflow: hidden;
				transition: border-color var(--dur-state) var(--ease-out);
			}

			/* keep the logo a fixed square; fit the image inside it */
			img.row-logo {
				padding: 0.35rem;
				object-fit: contain;
			}

			.project-row:hover .row-logo,
			.project-row:focus-within .row-logo {
				border-color: var(--accent);
			}

			.row-kind {
				display: inline-block;
				margin: 0 0 0.55rem;
				color: var(--accent);
				font-size: 0.74rem;
				font-weight: 500;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.row-title {
				margin: 0;
				font-family: var(--font-display);
				font-size: 2.3rem;
				font-weight: 800;
				letter-spacing: -0.015em;
				line-height: 1.04;
			}

			.row-link {
				color: var(--ink);
				transition: color var(--dur-state) var(--ease-out);
			}

			.project-row:hover .row-link,
			.row-link:focus-visible {
				color: var(--accent);
			}

			.row-arrow {
				display: inline-block;
				margin-left: 0.5rem;
				/* Fraunces draws no U+2192; Karrik does. Keep the arrow in the body face. */
				font-family: var(--font-body);
				color: var(--accent);
				font-size: 0.62em;
				opacity: 0;
				transform: translate(-5px, 5px);
				transition:
					opacity var(--dur-state) var(--ease-out),
					transform var(--dur-state) var(--ease-out);
			}

			.project-row:hover .row-arrow,
			.row-link:focus-visible .row-arrow {
				opacity: 1;
				transform: translate(0, 0);
			}

			.row-desc {
				max-width: 62ch;
				margin: 0.9rem 0 0;
				color: var(--ink-muted);
				font-size: 1.02rem;
				line-height: 1.6;
			}

			.back-link:hover,
			.back-link:focus-visible {
				text-decoration: underline;
				text-underline-offset: 0.3em;
			}

			.project-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				list-style: none;
				margin: 1.3rem 0 0;
				padding: 0;
			}

			.project-tags li {
				border: 1px solid var(--line);
				border-radius: 999px;
				background: transparent;
				color: var(--ink-muted);
				font-size: 0.72rem;
				letter-spacing: 0.02em;
				line-height: 1;
				padding: 0.4rem 0.72rem;
				white-space: nowrap;
			}

			.detail-tags {
				margin-top: 2rem;
			}

			.link-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.7rem;
				margin-top: 1.5rem;
			}

			/* compact variant of the hero pills, sized for the detail aside */
			.link-btn {
				padding: 0.65rem 1.15rem;
				font-size: 0.78rem;
			}

			.back-link {
				display: inline-block;
				margin-bottom: 2rem;
				color: var(--accent);
				font-size: 0.9rem;
				font-weight: 700;
			}

			.prose {
				max-width: 760px;
				margin-top: 2rem;
			}

			.prose p {
				margin: 0 0 1.25rem;
				color: var(--ink-muted);
				font-size: 1.08rem;
				line-height: 1.65;
			}

			.project-detail {
				min-height: calc(100vh - 58px);
			}

			.detail-header {
				max-width: 860px;
			}

			.detail-body {
				display: grid;
				grid-template-columns: minmax(0, 760px) minmax(12rem, 1fr);
				gap: 3rem;
				align-items: start;
				margin-top: 2.8rem;
			}

			.detail-aside {
				position: sticky;
				top: 7rem;
				border-left: 1px solid var(--line);
				padding-left: 1.25rem;
			}

			.detail-aside p {
				margin: 0 0 0.75rem;
				color: var(--ink-soft);
				font-size: 0.82rem;
				line-height: 1.5;
				text-transform: uppercase;
			}

			.project-embed {
				width: 100%;
				min-height: 420px;
				margin-top: 2rem;
				border: 1px solid var(--line);
				border-radius: var(--radius-edge);
				background: var(--ground-lift);
			}

			.text-page {
				min-height: calc(100vh - 58px);
			}

			.about-layout {
				display: grid;
				grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr);
				gap: 3rem;
				align-items: start;
				margin-top: 2.6rem;
			}

			.about-photo {
				position: relative;
				margin: 0;
			}


			.about-photo img {
				display: block;
				width: 100%;
				aspect-ratio: 4 / 5;
				border: 1px solid var(--line-strong);
				border-radius: var(--radius-edge);
				object-fit: cover;
				object-position: 50% 38%;
			}

			.about-photo figcaption {
				margin-top: 0.7rem;
				color: var(--ink-soft);
				font-size: 0.8rem;
			}

			.about-side {
				display: grid;
				gap: 1.7rem;
			}

			/* field-notes style fact list */
			.about-facts {
				display: grid;
				gap: 1rem;
				margin: 0;
			}

			.about-facts > div {
				display: grid;
				gap: 0.25rem;
				border-left: 1px solid var(--line);
				padding-left: 0.9rem;
			}

			.about-facts dt {
				color: var(--accent);
				font-size: 0.7rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.about-facts dd {
				margin: 0;
				color: var(--ink-muted);
				font-size: 0.95rem;
				line-height: 1.45;
			}

			.site-footer {
				position: relative;
				z-index: 1;
				margin-top: 6rem;
				padding: 2.4rem 1rem 3rem;
				text-align: center;
			}

			.footer-line {
				margin: 0;
				color: var(--ink-soft);
				font-size: 0.85rem;
				letter-spacing: 0.02em;
			}

			.footer-line a {
				color: var(--accent);
				transition: color var(--dur-state) var(--ease-out);
			}

			.footer-line a:hover,
			.footer-line a:focus-visible {
				color: var(--accent);
			}



				to {
					background-position: 32% 0%, 68% 0%;
					transform: skewX(-4deg) translate3d(3vw, 1.5vh, 0);
				}
			}

				to {
					opacity: 0.95;
				}
			}

				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

				to {
					background-position: 100% 50%;
				}
			}

				50% {
					opacity: 0.45;
					transform: scale(0.78);
				}
			}

				100% {
					transform: translateX(240%);
				}
			}

			@media (max-width: 920px) {
				.hero h1,
				.page-title {
					font-size: 4.2rem;
				}

				.section-heading {
					font-size: 2.9rem;
				}

				.about-layout,
				.detail-body {
					grid-template-columns: 1fr;
				}

				.detail-aside {
					position: static;
					border-left: 0;
					border-top: 1px solid var(--line);
					padding: 1.25rem 0 0;
				}
			}

			@media (max-width: 700px) {
				.site-nav {
					align-items: center;
					padding: 0.8rem 1rem;
				}

				.site-name span {
					display: none;
				}

				.nav-links {
					gap: 0.85rem;
					font-size: 0.75rem;
				}

				.hero {
					min-height: calc(100vh - 58px);
					padding: 5rem 0 6rem;
				}

				.hero-scroll {
					bottom: 1.4rem;
				}

				.hero-meta {
					font-size: 0.72rem;
					gap: 0.7rem;
				}

				.hero h1,
				.page-title {
					font-size: 3.1rem;
					line-height: 1;
				}

				.blurb {
					font-size: 1.08rem;
				}

				.section-heading {
					font-size: 2.4rem;
				}

				.page-section {
					padding: 5rem 0;
				}

				.project-row {
					grid-template-columns: 2.6rem minmax(0, 1fr);
					gap: 1rem;
					padding: 2rem 0.5rem;
				}

				.project-row:hover,
				.project-row:focus-within {
					padding-left: 0.9rem;
				}

				.row-logo {
					width: 2.6rem;
					height: 2.6rem;
					font-size: 1.2rem;
					border-radius: 10px;
				}

				.row-title {
					font-size: 1.85rem;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				/* A genuine no-motion path, not a 1ms duration. Nothing moves;
				   hover and focus still change colour, so states stay legible. */
				*,
				*::before,
				*::after {
					animation: none !important;
					transition: none !important;
				}

				html {
					scroll-behavior: auto;
				}
			}
		</style>
	</head>
